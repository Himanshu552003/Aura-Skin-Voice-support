# Copy this file to ".env" and replace the placeholders with your real keys.
# Never commit the .env file.

# Groq: speech-to-text (Whisper) + LLM with tool calling. Get it at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI: Bulbul text-to-speech (Indian voice). Get it at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional overrides (defaults shown). Other Bulbul v3 voices to try: ritu, neha, kavya, simran
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# STT_MODEL=whisper-large-v3-turbo
# TTS_SPEAKER=priya

# Hugging Face token: only needed for deployment (WebRTC TURN server on Spaces).
# Get it at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here
