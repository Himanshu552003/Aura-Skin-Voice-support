# Copy this file to ".env" and replace the placeholders with your real keys.
# Never commit the .env file.

# Groq: speech-to-text (Whisper) + LLM with tool calling. Get it at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Sarvam AI: Bulbul text-to-speech (Indian voice). Get it at https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional overrides (defaults shown). Other Bulbul v3 voices to try: ritu, neha, kavya, simran
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b
# STT_MODEL=whisper-large-v3-turbo
# TTS_SPEAKER=priya

# Cloudflare TURN relay: only needed when deployed (Hugging Face Spaces), so the
# browser can connect to the server. Free. Cloudflare dashboard > Realtime > TURN Server.
# Leave empty for local use.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
